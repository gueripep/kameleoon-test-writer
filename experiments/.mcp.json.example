{
  "mcpServers": {
    "local-cro-bridge": {
      "command": "node",
      "args": [
        "/absolute/path/to/kameleoon-test-writer/local-cro-workflow/cli/bin/cro-agent.js",
        "/absolute/path/to/kameleoon-test-writer/experiments"
      ]
    },
    "dembrandt": {
      "command": "npx",
      "args": ["-y", "dembrandt-mcp"]
    }
  }
}
