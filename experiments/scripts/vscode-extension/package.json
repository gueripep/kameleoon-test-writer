{
  "name": "kameleoon-experiment-archive",
  "displayName": "Kameleoon Experiment Archive",
  "description": "Right-click an .archive folder to restore that experiment.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "kameleoonArchive.restore", "title": "Restore This Experiment" },
      { "command": "kameleoonArchive.archive", "title": "Archive & Reset Variation" }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "kameleoonArchive.restore",
          "when": "explorerResourceIsFolder && resourcePath =~ /[\\\\/]\\.archive[\\\\/][^\\\\/]+$/",
          "group": "2_workspace"
        }
      ],
      "commandPalette": [
        { "command": "kameleoonArchive.restore", "when": "false" }
      ]
    }
  }
}
