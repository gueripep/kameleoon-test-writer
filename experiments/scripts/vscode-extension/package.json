{
  "name": "kameleoon-experiment-archive",
  "displayName": "Kameleoon CRO Workspace",
  "description": "Bridge status, experiment archive and HubSpot ticket kickoff for the local CRO workspace.",
  "version": "1.0.0",
  "publisher": "local",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "kameleoonArchive.restore", "title": "Restore This Experiment", "icon": "$(history)" },
      { "command": "kameleoonArchive.archive", "title": "Kameleoon: Archive & Reset Variation", "icon": "$(archive)" },
      { "command": "kameleoonArchive.compare", "title": "Compare With Current", "icon": "$(diff)" },
      { "command": "kameleoonArchive.startFromTicket", "title": "Kameleoon: Start From HubSpot Ticket", "icon": "$(rocket)" },
      { "command": "kameleoonArchive.startFromImportedTicket", "title": "Start From This Ticket", "icon": "$(rocket)" },
      { "command": "kameleoonArchive.toggleBridge", "title": "Kameleoon: Pause/Resume Injection" },
      { "command": "kameleoonArchive.refresh", "title": "Refresh", "icon": "$(refresh)" }
    ],
    "views": {
      "explorer": [
        { "id": "kameleoonExperiments", "name": "Kameleoon Experiments" }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "kameleoonArchive.restore",
          "when": "explorerResourceIsFolder && resourcePath =~ /[\\\\/]\\.archive[\\\\/][^\\\\/]+$/",
          "group": "2_workspace"
        }
      ],
      "view/title": [
        { "command": "kameleoonArchive.startFromTicket", "when": "view == kameleoonExperiments", "group": "navigation@1" },
        { "command": "kameleoonArchive.archive", "when": "view == kameleoonExperiments", "group": "navigation@2" },
        { "command": "kameleoonArchive.refresh", "when": "view == kameleoonExperiments", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "kameleoonArchive.compare", "when": "view == kameleoonExperiments && viewItem == archive", "group": "inline@1" },
        { "command": "kameleoonArchive.restore", "when": "view == kameleoonExperiments && viewItem == archive", "group": "inline@2" },
        { "command": "kameleoonArchive.startFromImportedTicket", "when": "view == kameleoonExperiments && viewItem == ticket", "group": "inline" }
      ],
      "commandPalette": [
        { "command": "kameleoonArchive.restore", "when": "false" },
        { "command": "kameleoonArchive.compare", "when": "false" },
        { "command": "kameleoonArchive.startFromImportedTicket", "when": "false" },
        { "command": "kameleoonArchive.refresh", "when": "false" }
      ]
    }
  }
}
