{
  "manifest_version": 3,
  "name": "Local CRO Bridge",
  "version": "1.0",
  "description": "Bridges local file changes to the active tab via WebSockets.",
  "permissions": [
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "cookies",
    "browsingData",
    "declarativeNetRequest",
    "alarms",
    "debugger",
    "webNavigation"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local CRO Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lifecycle_recorder.js", "console_interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_logger.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "csp_bypass",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
